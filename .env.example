# ==================================================
# AUREVIA - Environment Configuration Example
# ==================================================
# Copy this file to .env and adjust variables as required.

DB_HOST=localhost
DB_PORT=3306
DB_NAME=aurevia_library
DB_USERNAME=your_username
DB_PASSWORD=your_password
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/aurevia_library?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SERVER_PORT=8080
